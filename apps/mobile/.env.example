# Copy to apps/mobile/.env for local development (Expo reads EXPO_PUBLIC_* at build time).
# Placeholders only. Never commit apps/mobile/.env (it is git-ignored).

# The API the app talks to. Leave unset in development to use the default:
# http://localhost:4100 (web, iOS simulator) or http://10.0.2.2:4100 (Android emulator).
# On a real phone, use your computer's LAN address, for example http://192.168.1.20:4100
# EXPO_PUBLIC_API_URL=http://localhost:4100

# "Continue with Google" web OAuth client id. Optional: the default in src/lib/config.ts is the project's public client id.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Feature flags for unfinished features: leave off unless you are working on them.
EXPO_PUBLIC_FEATURE_PAID_EVENTS=off
EXPO_PUBLIC_FEATURE_ID_VERIFICATION=off
