{
  "expo": {
    "name": "Tablamigo",
    "slug": "tablamigo",
    "version": "1.4.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tablamigo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tablamigo.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.tablamigo.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 19,
      "adaptiveIcon": {
        "backgroundColor": "#FF6A42",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "tablamigo.hookstep.in", "pathPrefix": "/app/activity/" },
            { "scheme": "https", "host": "tablamigo.hookstep.in", "pathPrefix": "/app/chat/" },
            { "scheme": "https", "host": "tablamigo.hookstep.in", "pathPrefix": "/app/user/" },
            { "scheme": "https", "host": "tablamigo.hookstep.in", "pathPrefix": "/app/trip/" },
            { "scheme": "https", "host": "tablamigo.hookstep.in", "pathPrefix": "/app/city/" },
            { "scheme": "https", "host": "tablamigo.hookstep.in", "pathPrefix": "/app/m/" }
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "themeColor": "#FF5A36",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6A42",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF5A36",
          "defaultChannel": "default"
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-iap",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tablamigo uses your location to show plans and travellers near you. Plans show a rounded distance. If you choose to share live location in a chat, people in that chat see your exact position until you stop or it expires."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a profile photo or share a photo in a chat.",
          "cameraPermission": "Take a selfie to verify your profile."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
