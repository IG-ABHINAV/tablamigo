# Copy to apps/api/.env for local development. Every value here is a placeholder or a local default:
# never put a real key in this file, and never commit apps/api/.env (it is git-ignored).
#
# With only the defaults below the API boots against the Docker database from infra/docker-compose.dev.yml
# (npm run db at the repo root), prints login codes to the console instead of emailing them, stores photos on disk,
# and skips every outside service (push, payments, moderation) that has no key.

# --- Required ---
# Matches infra/docker-compose.dev.yml (Postgres + PostGIS on port 5434).
DATABASE_URL=postgres://tablamigo:tablamigo-local@localhost:5434/tablamigo
# Any long random string in production (32+ characters, enforced when NODE_ENV=production). This one is for local use only.
JWT_SECRET=dev-only-secret-change-me

# --- Server ---
PORT=4100
PUBLIC_URL=http://localhost:4100
# Base URL for links in emails. Defaults to the production site; point it at your local web build if you test email links.
# SITE_URL=http://localhost:5199
# Leave unset locally. In production, set to production.
# NODE_ENV=development

# --- Admins ---
# Comma-separated emails that can sign in to the admin panel. There is no default: leave it empty and nobody is admin
# by email (an account with users.role = 'admin' still is). Use an address you can read, or one of your own test accounts.
ADMIN_EMAILS=

# --- Everything free ---
# While true, every account is treated as Plus and nothing is sold. Set false to work on the paid-plan code paths.
ALL_FREE=true

# --- Optional outside services (all off when empty) ---
# Email: without a key, login codes are printed in the API console. Required in production.
RESEND_API_KEY=
MAIL_FROM=Tablamigo <hello@example.com>
SUPPORT_EMAIL=support@example.com
# AI moderation and plan ideas.
OPENAI_API_KEY=
# Photos on Cloudflare R2. Without these, uploads go to local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PREFIX=
# Push notifications: Firebase service account JSON file path, and Web Push (VAPID) keys.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:support@example.com
# Payments (not needed while ALL_FREE=true).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
TABLAMIGO_FORWARD_SECRET=
PLAY_SERVICE_ACCOUNT_JSON=
# The owner's sale alerts (lib/owner-alerts.ts): one email per purchase, charge, renewal, cancellation, payment problem and
# refund, to these addresses only (comma-separated). Empty: no alerts. Customer receipts never go here.
OWNER_SALES_ALERT_EMAIL=
# Play acknowledgement safety net (lib/play-ack.ts): a purchase still not acknowledged this many hours after it was bought is
# retried by the scheduler (default 1), and the owner (OWNER_SALES_ALERT_EMAIL) is emailed once it is PLAY_ACK_ALERT_HOURS old
# (default 24, at most 48; Google refunds at 72).
PLAY_ACK_GRACE_HOURS=
PLAY_ACK_ALERT_HOURS=
# Creator partners (lib/affiliate-ledger.ts): Google's fee taken off a Play charge before the partner's share, when Google's order
# doesn't state our revenue itself. Default 15 (subscriptions; other sales under $1M a year).
AFFILIATE_PLAY_FEE_PERCENT=
# Google Play notifications (POST /billing/google/rtdn): production needs one of these or refuses to start (and the route
# refuses every post). RTDN_PUSH_EMAIL (Pub/Sub's signed token from that service account) is preferred over a URL token.
RTDN_TOKEN=
RTDN_PUSH_EMAIL=

# --- Switches ---
# Background jobs. Set either to off to keep a local run quiet.
SCHEDULER=on
EMAIL_JOBS=on
# The store rating ask (POST /me/review-ask). Off unless on: with few users yet, nobody is asked (owner, 2 Nov 2026).
REVIEW_ASK=off
# The Tablamigo Host's welcome DM to new users, and the community starter plans it lists: off | dry | on. Unset means dry
# (logs what it would do, writes nothing). Switch STARTER_PLANS on first, HOST_WELCOME a day later.
HOST_WELCOME=dry
STARTER_PLANS=dry
# Automatic team messages, the email ladder and engagement loops (migration 069; off | dry | on, unset = dry):
# trip match alerts (lib/trip-match.ts), the Plus welcome (lib/plus-welcome.ts), the empty-city nudge (lib/city-nudge.ts),
# email fallbacks for unread DMs / plan reminders / team messages (lib/ladder.ts), plan-view summaries and trip-soon email
# (lib/engagement.ts). TRIP_MATCH_PER_DAY caps trip match alerts per person per 24 h (default 3).
TRIP_MATCH=dry
PLUS_WELCOME=dry
CITY_NUDGE=dry
EMAIL_LADDER=dry
ENGAGEMENT=dry
# Host rewards (lib/host-rewards.ts): 7 days of Plus for hosting a plan 2+ real travellers went to, at most 2 per 30 days. off | dry | on.
HOST_REWARDS=dry
TRIP_MATCH_PER_DAY=3
# Escalation channels after email (lib/channels.ts), in order WhatsApp -> Telegram -> SMS. Each stays off until all of its
# values are set. WhatsApp: Meta Cloud API, one approved utility template with two body parameters (title, text + link).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Telegram: the bot from @BotFather; setWebhook to <PUBLIC_URL>/telegram/webhook with secret_token = TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# SMS: Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Feature flags for unfinished features: leave off unless you are working on them.
FEATURE_PAID_EVENTS=off
FEATURE_ID_VERIFICATION=off
FEATURE_VOICE_NOTES=off
