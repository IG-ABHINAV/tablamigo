{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["src"], "exclude": ["src/**/*.test.ts", "src/test-setup.ts", "src/test-unit-setup.ts", "src/test-db-guard.ts", "src/tests/**"]
}
