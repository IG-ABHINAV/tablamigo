{
  "name": "@tablamigo/api",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node scripts/fetch-face-models.mjs && tsc -p . && cp -R src/db/migrations dist/db/",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "pretest": "npm run typecheck",
    "test": "node scripts/fetch-face-models.mjs && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/fetch-face-models.mjs && vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:scenarios": "tsx src/scripts/e2e-scenarios.ts",
    "e2e": "tsx src/scripts/e2e-scenarios.ts",
    "models": "node scripts/fetch-face-models.mjs",
    "face:calibrate": "tsx src/scripts/face-calibrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "onnxruntime-node": "^1.30.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
